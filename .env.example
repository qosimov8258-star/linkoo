# Postgres (used by docker-compose and by the app to build DATABASE_URL)
POSTGRES_USER=linko
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=linko
POSTGRES_PORT=5432

# Full connection string the app actually reads. When running via
# docker-compose this is assembled automatically from the vars above; when
# running `pnpm dev` locally against `docker compose up postgres`, set this
# explicitly to point at localhost.
DATABASE_URL=postgres://linko:change-me-to-a-strong-password@localhost:5432/linko

# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-secret

# Origin allowed to make cross-origin requests to the API (CORS). Set to your
# real deployed origin in production; same-origin requests are always allowed.
ALLOWED_ORIGIN=http://localhost:3000

APP_PORT=3000
