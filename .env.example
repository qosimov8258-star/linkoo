# Postgres (used by docker-compose and by the app to build DATABASE_URL)
POSTGRES_USER=linko
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=linko
POSTGRES_PORT=5432

# Full connection string the app actually reads. When running via
# docker-compose this is assembled automatically from the vars above; when
# running `pnpm dev` locally against `docker compose up postgres`, set this
# explicitly to point at localhost.
DATABASE_URL=postgres://linko:change-me-to-a-strong-password@localhost:5432/linko

# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-secret

# Origin allowed to make cross-origin requests to the API (CORS). Set to your
# real deployed origin in production; same-origin requests are always allowed.
ALLOWED_ORIGIN=http://localhost:3000

APP_PORT=3000

# Password of the first administrator ("admin"), used only when the users table
# is empty (fresh database). Leave it empty to have a random one-time password
# printed once to the server log instead. Either way the account must change
# the password at the first sign-in.
ADMIN_INITIAL_PASSWORD=

# Number of reverse proxies in front of the app that append to X-Forwarded-For
# (used to find the real client address for rate limits and session logs).
# Default 1 = the bundled nginx. Set 2 when another proxy/load balancer sits in
# front of nginx.
TRUSTED_PROXY_HOPS=1

# Extra hosts allowed to open the dev server (next dev), comma-separated.
# Example: a LAN/VPN IP of this machine.
ALLOWED_DEV_ORIGINS=

# «AI yordamchi» (bug reports, lib/bug-reports). Any OpenAI-compatible API; Groq by default. Without
# GROQ_API_KEY reports are still saved and sent to Telegram: the helper is skipped and the screenshot
# analysis is marked FAILED ("GROQ_API_KEY не задан"). Read at call time, no restart needed in dev.
AI_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
# Model that reads the screenshot (image input) and explains the report to the developer.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Text model that answers the customer from docs/ai-qollanma.md before the report goes out.
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Telegram notification of every delivered report (both must be set; otherwise nothing is sent).
# The bot must be a member of the chat; TELEGRAM_CHAT_ID is the chat's numeric id (-100… for groups).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public address of the app, used for the admin links in Telegram (falls back to ALLOWED_ORIGIN).
APP_PUBLIC_URL=
# One Telegram bot can serve several projects: each message starts with this name and its hashtag, and when the
# chat has topics (a group with Topics, or the bot's private chat with Threaded Mode on in @BotFather) the bot
# opens one topic per project. TELEGRAM_THREAD_ID pins a topic by hand (optional).
BUG_REPORT_PROJECT_NAME=Mezon
TELEGRAM_THREAD_ID=
